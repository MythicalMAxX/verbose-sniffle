# Database
# DATABASE_URL is used by Prisma Client at runtime.
# DIRECT_URL is optional, but recommended for running Prisma migrations when using Prisma Accelerate/Data Proxy.
DATABASE_URL="postgresql://user:password@localhost:5432/mydb?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/mydb?schema=public"

# Auth (e.g. NextAuth.js)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Public
NEXT_PUBLIC_APP_URL="http://localhost:3000"
