# Prisma loads environment variables from this file when running prisma CLI commands.
# For local development, point both variables at your local Postgres.
# For Prisma Accelerate / Data Proxy on Vercel, set DATABASE_URL to the prisma:// URL
# and DIRECT_URL to your direct postgresql:// connection for migrations.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/mydb?schema=public"
